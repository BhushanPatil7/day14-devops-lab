# Copy this file to .env.local and fill in your own values (.env.local is never committed).
VITE_ENV_LABEL=DEV
VITE_APP_VERSION=1.0.0

# Section 5: from sentry.io → your React project → Settings → Client Keys (DSN). Safe in frontend code.
VITE_SENTRY_DSN=

# Section 6: from logrocket.com → your project → Setup (looks like your-org/your-app).
VITE_LOGROCKET_APP_ID=
